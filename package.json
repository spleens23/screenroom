{
  "name": "screenroom",
  "version": "0.5.0",
  "description": "Netflix-style browser for your local MP4 library, with mpv playback (Dolby, DTS, H.264/H.265, up to 4K)",
  "author": "Screenroom <screenroom@localhost>",
  "homepage": "https://localhost/screenroom",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "scan": "node scripts/scan.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.screenroom.app",
    "productName": "Screenroom",
    "copyright": "Copyright © 2026 the Screenroom authors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "tools/**/*",
      "renderer/**/*",
      "remote/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "mpv",
        "to": "mpv"
      },
      {
        "from": "remote",
        "to": "remote"
      },
      {
        "from": "deploy",
        "to": "deploy",
        "filter": [
          "**/*",
          "!installer/**",
          "!*.md"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Screenroom"
    },
    "linux": {
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Screenroom <screenroom@localhost>",
      "synopsis": "Netflix-style local media browser",
      "desktop": {
        "entry": {
          "Name": "Screenroom",
          "Comment": "Browse and play your local library"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1"
      ],
      "afterInstall": "build/deb-after-install.sh"
    },
    "asarUnpack": [
      "tools/*.py"
    ]
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
