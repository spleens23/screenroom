#!/bin/sh
# Screenroom TV box: which screen to use. On a laptop, the TV (HDMI / DisplayPort / USB-C) wins whenever one is
# plugged in and the laptop's own panel switches off; unplug the TV and the panel comes back on.
# Runs in the background from screenroom-session and checks every few seconds. A desktop mini PC with one
# screen is left as it is.
command -v xrandr >/dev/null || exit 0

# The TV's own favourite mode can be 4K at only 30 Hz (laptop HDMI ports often can't do 4K at 60), which makes
# films judder and stutter. Then use the sharpest mode that runs at 50-60 Hz instead (usually 1080p at 60 Hz).
# Prints "WIDTHxHEIGHT RATE", or nothing when the TV's favourite mode is already smooth.
smooth_mode() {
  xrandr --query 2>/dev/null | awk -v out="$1" '
    $1 == out { inside = 1; next }
    inside && !/^ / { inside = 0 }
    inside {
      mode = $1; px = 0; split(mode, d, "x"); px = d[1] * d[2]
      last = ""
      for (i = 2; i <= NF; i++) {
        r = $i; pref = (r ~ /\+/); gsub(/[*+]/, "", r)
        if (r == "") { if (pref && last != "") prefRate = last + 0; continue }   # a lone "+" marks the rate before it
        last = r
        if (pref) { prefRate = r + 0 }
        if (r + 0 >= 49 && px > best) { best = px; bestMode = mode; bestRate = r }
      }
    }
    END { if (prefRate != "" && prefRate < 49 && bestMode != "") print bestMode " " bestRate }'
}

apply() {
  q="$(xrandr --query 2>/dev/null)" || return
  internal="$(echo "$q" | awk '/ connected/ && $1 ~ /^(eDP|LVDS|DSI)/ {print $1; exit}')"
  external="$(echo "$q" | awk '/ connected/ && $1 !~ /^(eDP|LVDS|DSI)/ {print $1; exit}')"
  [ -n "$internal" ] || return 0              # not a laptop: nothing to do
  # Every other output is switched off, including one whose TV was just unplugged: left on, it kept the
  # picture TV-sized and the laptop screen showed only its top-left corner, zoomed in.
  others() { echo "$q" | awk -v keep="$1" '/ (connected|disconnected)/ && $1 != keep {printf "--output %s --off ", $1}'; }
  if [ -n "$external" ]; then
    mode="$(smooth_mode "$external")"
    if [ -n "$mode" ]; then
      # shellcheck disable=SC2046
      xrandr --output "$external" --mode "${mode% *}" --rate "${mode#* }" --primary --pos 0x0 $(others "$external")
    else
      # shellcheck disable=SC2046
      xrandr --output "$external" --auto --primary --pos 0x0 $(others "$external")
    fi
  else
    # shellcheck disable=SC2046
    xrandr --output "$internal" --auto --primary --pos 0x0 $(others "$internal")
    # and shrink the picture back to the laptop screen's own size
    size="$(echo "$q" | awk -v o="$internal" '$1 == o {f=1; next} f && /^ / && /\+/ {print $1; exit} f && !/^ / {exit}')"
    [ -n "$size" ] && xrandr --fb "$size" 2>/dev/null
  fi
}

# Watching for a TV being plugged in or out. Never with "xrandr --query" every few seconds: that re-reads every
# screen's details over the HDMI cable each time, which made everything (picture, menus, music over HDMI) stutter.
# Instead: wait for the kernel's "a screen was plugged/unplugged" events, or look at what X already knows.
connected() { xrandr --current 2>/dev/null | awk '/ connected/ {print $1}' | tr '\n' ' '; }
apply
[ "${1:-}" = "--once" ] && exit 0
last="$(connected)"
if command -v udevadm >/dev/null 2>&1; then
  udevadm monitor --udev --subsystem-match=drm 2>/dev/null | while read -r line; do
    case "$line" in *change*|*add*|*remove*)
      sleep 2                          # let the TV finish waking up and say what it can do
      now="$(xrandr --query 2>/dev/null | awk '/ connected/ {print $1}' | tr '\n' ' ')"
      if [ "$now" != "$last" ]; then apply; last="$now"; fi ;;
    esac
  done
fi
# no udev events available: check what X knows (cheap, no re-reading of the screens) now and then
while true; do
  sleep 5
  now="$(connected)"
  if [ "$now" != "$last" ]; then apply; last="$now"; fi
done
