#!/bin/sh
# Screenroom TV session: what runs when the TV box logs in automatically.
# Installed to /usr/local/bin/screenroom-session by install-tv.sh.

# The mouse pointer only shows while a mouse / touchpad is actually being moved (never on the TV otherwise).
# Started first, so the pointer is hidden from the very first moment.
if command -v unclutter >/dev/null; then
  unclutter --start-hidden --timeout 2 --hide-on-touch >/dev/null 2>&1 &
fi

# Keep the screen on while the box is on (the TV handles its own sleep / power).
xset s off
xset -dpms
xset s noblank
# Dark background straight away (no grey flash before Screenroom draws).
xsetroot -solid '#16110D' 2>/dev/null || true

# Smooth, unhinted text at 96 dpi (the app scales itself up for the TV).
xrdb -merge <<'XRES'
Xft.dpi: 96
Xft.antialias: 1
Xft.hinting: 0
Xft.rgba: none
Xft.autohint: 0
XRES

# Sound outputs on (a fresh install can leave the headphone jack / HDMI muted).
[ -x /usr/local/bin/screenroom-audio-setup ] && /usr/local/bin/screenroom-audio-setup &

# Laptops: use the TV when one is plugged in (the laptop's own screen switches off), the laptop screen otherwise.
if [ -x /usr/local/bin/screenroom-display ]; then
  /usr/local/bin/screenroom-display --once
  /usr/local/bin/screenroom-display >/tmp/screenroom-display.log 2>&1 &
fi


# A tiny window manager so full-screen windows (Screenroom, then the mpv player) stack properly.
openbox &

# Mount USB drives and SD cards automatically when they're plugged in (they appear under /media/tv/).
if command -v udiskie >/dev/null; then
  udiskie --no-tray --no-notify --automount --no-config >/tmp/screenroom-udiskie.log 2>&1 &
fi

# Let the TV remote work over HDMI-CEC (does nothing if there's no CEC adapter).
if [ -x /usr/local/bin/screenroom-cec ]; then
  /usr/local/bin/screenroom-cec >/tmp/screenroom-cec.log 2>&1 &
fi

# Run Screenroom in TV mode, and start it again whenever it stops (crash, update, or "Restart Screenroom"),
# so the box never drops to a login screen.
while true; do
  screenroom --tv
  sleep 1
done
